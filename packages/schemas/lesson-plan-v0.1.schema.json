{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.dev/schemas/lesson-plan-v0.1.schema.json",
  "title": "Mosaic Source-Grounded Lesson Plan v0.1",
  "description": "An agent intermediate artifact that maps supplied education sources to learner objectives, lesson stages, visuals, feedback, and assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "metadata", "sources", "audience", "prerequisites", "objectives", "misconceptions", "stages", "assessment", "simulation"],
  "properties": {
    "version": { "const": "0.1" },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "summary"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "title": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 } }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "sections"],
        "properties": { "id": { "type": "string" }, "path": { "type": "string" }, "sections": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
      }
    },
    "audience": { "type": "string", "minLength": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "objectives": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "outcome", "sourceRefs"],
        "properties": { "id": { "type": "string" }, "outcome": { "type": "string", "minLength": 1 }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["misconception", "correction", "sourceRefs"],
        "properties": { "misconception": { "type": "string" }, "correction": { "type": "string" }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } }
      }
    },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "objectiveRefs", "teachingPurpose", "learnerText", "visual", "learnerAction", "outcomeExplanation", "nextAction", "sourceRefs"],
        "properties": {
          "id": { "type": "string" },
          "objectiveRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "teachingPurpose": { "type": "string", "minLength": 1 },
          "learnerText": { "type": "string", "minLength": 1 },
          "visual": {
            "type": "object", "additionalProperties": false, "required": ["mosaicComponent", "purpose", "stateMapping"],
            "properties": {
              "mosaicComponent": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "stateMapping": { "type": "array", "items": { "type": "string" } }
            }
          },
          "learnerAction": {
            "type": "object", "additionalProperties": false, "required": ["type", "label"],
            "properties": { "type": { "enum": ["predict", "choose", "step", "adjust", "observe", "reflect"] }, "label": { "type": "string", "minLength": 1 }, "prompt": { "type": "string" }, "choices": { "type": "array", "items": { "type": "string" } } }
          },
          "outcomeExplanation": { "type": "string", "minLength": 1 },
          "nextAction": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
        }
      }
    },
    "assessment": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["objectiveRefs", "question", "options", "correctOptionId", "correctFeedback", "retryFeedback"],
        "properties": {
          "objectiveRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "question": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" } } } },
          "correctOptionId": { "type": "string" },
          "correctFeedback": { "type": "string", "minLength": 1 },
          "retryFeedback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "simulation": {
      "type": "object", "additionalProperties": false, "required": ["needed", "stateFields", "parameters", "invariants", "edgeCases"],
      "properties": {
        "needed": { "type": "boolean" },
        "stateFields": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "array", "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "edgeCases": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["sourceId", "section"], "properties": { "sourceId": { "type": "string" }, "section": { "type": "string" } } } }
  }
}
