    "framer-motion": "^13.1.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
